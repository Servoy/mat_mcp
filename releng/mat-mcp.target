<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?pde version="3.8"?>
<target name="mat-mcp" sequenceNumber="1">
	<locations>
		<!--
			Eclipse platform + Equinox runtime. MAT 1.17 is built on the 2026-03 (4.39) release
			train; use a matching Eclipse release repository so core.runtime / equinox.app resolve.
		-->
		<location includeAllPlatforms="false" includeConfigurePhase="true" includeMode="planner" includeSource="false" type="InstallableUnit">
			<repository location="https://download.eclipse.org/releases/2026-03/"/>
			<unit id="org.eclipse.sdk.feature.group" version="0.0.0"/>
			<unit id="org.eclipse.equinox.executable.feature.group" version="0.0.0"/>
		</location>

		<!--
			Eclipse Memory Analyzer bundles (org.eclipse.mat.* api/report/parser + the ui bundle and
			its Jetty EE8 / jakarta.servlet-api deps) resolved from MAT's official p2 update-site, so
			the build works identically locally and on CI (a GitHub runner has no local MAT install).
			Pin to the exact MAT version this plugin targets.
		-->
		<location includeAllPlatforms="false" includeConfigurePhase="true" includeMode="planner" includeSource="false" type="InstallableUnit">
			<repository location="https://download.eclipse.org/mat/1.17.0/update-site/"/>
			<unit id="org.eclipse.mat.api" version="0.0.0"/>
			<unit id="org.eclipse.mat.report" version="0.0.0"/>
			<unit id="org.eclipse.mat.parser" version="0.0.0"/>
			<unit id="org.eclipse.mat.hprof" version="0.0.0"/>
			<unit id="org.eclipse.mat.ui" version="0.0.0"/>
		</location>

		<!--
			Model Context Protocol Java SDK (and its Jackson JSON binding) from Maven Central,
			resolved as OSGi bundles via the m2e / Tycho Maven location.
		-->
		<location includeDependencyDepth="infinite" includeDependencyScopes="compile" includeSource="false" missingManifest="generate" type="Maven">
			<dependencies>
				<dependency>
					<groupId>io.modelcontextprotocol.sdk</groupId>
					<artifactId>mcp-core</artifactId>
					<version>2.0.1</version>
					<type>jar</type>
				</dependency>
				<dependency>
					<groupId>io.modelcontextprotocol.sdk</groupId>
					<artifactId>mcp-json-jackson2</artifactId>
					<version>2.0.1</version>
					<type>jar</type>
				</dependency>
				<!--
					MAT 1.17 ships Jetty 12.1.6 but only the EE8 (javax.servlet) servlet layer, while the
					MCP servlet transport is compiled against jakarta.servlet 6.x. Pull the matching EE10
					(jakarta) servlet layer at the same 12.1.6 so the shared core Jetty server/io/util
					bundles already present in MAT are reused and only the EE10 servlet classes are added.
				-->
				<dependency>
					<groupId>org.eclipse.jetty.ee10</groupId>
					<artifactId>jetty-ee10-servlet</artifactId>
					<version>12.1.6</version>
					<type>jar</type>
				</dependency>
			</dependencies>
		</location>
	</locations>
</target>
