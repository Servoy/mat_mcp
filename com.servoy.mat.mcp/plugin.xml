<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <!-- Auto-start the MCP HTTP server when the workbench launches. -->
   <extension point="org.eclipse.ui.startup">
      <startup class="com.servoy.mat.mcp.internal.ui.StartupMcpServer"/>
   </extension>

   <!-- Toggle command + its handler. The icon/tooltip state is NOT driven by IElementUpdater
        (that does not get invoked in the E4 workbench MAT uses); StatusToolbar updates the E4
        MToolItem directly instead. -->
   <extension point="org.eclipse.ui.commands">
      <command
            id="com.servoy.mat.mcp.toggleServer"
            name="Toggle MCP Server"
            description="Start or stop the MAT MCP HTTP server"
            defaultHandler="com.servoy.mat.mcp.internal.ui.ToggleMcpServerHandler"/>
   </extension>

   <!-- default icon shown until StatusToolbar sets the live-state icon -->
   <extension point="org.eclipse.ui.commandImages">
      <image
            commandId="com.servoy.mat.mcp.toggleServer"
            icon="icons/mcp-off.svg"/>
   </extension>

   <extension point="org.eclipse.ui.menus">
      <!-- main toolbar button. The command id on the <command> element becomes the E4 MHandledToolItem's
           elementId, so StatusToolbar can find it via EModelService and swap its icon/tooltip at runtime. -->
      <menuContribution
            allPopups="false"
            locationURI="toolbar:org.eclipse.ui.main.toolbar?after=additions">
         <toolbar id="com.servoy.mat.mcp.toolbar">
            <command
                  commandId="com.servoy.mat.mcp.toggleServer"
                  id="com.servoy.mat.mcp.toolitem"
                  icon="icons/mcp-off.svg"
                  style="push"/>
         </toolbar>
      </menuContribution>
      <!-- Window menu entry -->
      <menuContribution
            allPopups="false"
            locationURI="menu:window?after=additions">
         <command
               commandId="com.servoy.mat.mcp.toggleServer"
               label="Toggle MCP Server"
               style="push"/>
      </menuContribution>
   </extension>
</plugin>
